{
  "name": "obsynk",
  "version": "0.0.1",
  "description": "Two-way sync between an Obsidian vault and a Google Drive folder",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "esbuild src/events/watcher.test.ts --bundle --platform=node --format=cjs --external:node:test --external:node:assert --outfile=.test-build/watcher.test.js && node --test .test-build/watcher.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.0",
    "obsidian": "latest",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.0"
  }
}
